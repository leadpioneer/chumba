# ============================================================
#  chumba local LLM stack — шаблон конфигурации
#  cp .env.example .env  и заполните секреты
# ============================================================

# ---- Orchestrator (llama.cpp) ----
# Образ llama.cpp (CUDA 13; поддерживает sm_120 / RTX 50xx).
# Важно: server-cuda13 требует драйвер с CUDA >= 13.4 (проверено: 617.14 / CUDA 13.4).
# Если драйвер старее — используйте ghcr.io/ggml-org/llama.cpp:server-cuda (CUDA 12).
# Пин по digest: обновление = заменить digest (см. README).
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda13@sha256:8c27804e7dd79c758d8e56722c2e393bfa32599e83d79f663e9e5ff8ac3b494f
# socat-форвардер: публикует host-порт для internal-only сервисов
# (ограничение Docker Desktop: порты internal-сети не публикуются напрямую)
SOCAT_IMAGE=alpine/socat@sha256:5ffbd6ae916cbad86a58fabe0d6d5a6fd5c2b47ddf031e82996baac9300e732f
# Tor SOCKS5 (поиск через Tor) и Byparr (stealth-браузер для чтения страниц)
TOR_IMAGE=peterdavehello/tor-socks-proxy@sha256:0cc12d36d31265ce828c8422a7e163a0bf46755e90531f4c7d38a6149f071729
BYPARR_IMAGE=ghcr.io/thephaseless/byparr@sha256:874f719518f617d03a60e03411fc5d090647e1a877041e81f8dc965927c7deb6
# Эмбеддинги для RAG (bge-m3, CPU) и файл модели в models/embeddings/
EMBEDDINGS_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:23fd59bc5e5b06ca68003a5772d441f0411fb723eeaff850b9111bcd2ac4fd33
EMBEDDINGS_MODEL_FILE=bge-m3-Q8_0.gguf
ORCHESTRATOR_MODEL_FILE=Huihui-Qwen3.8-27B-abliterated-UD-IQ4_XS.gguf
# Устарело: id модели задаётся секцией [orchestrator] в llama/models.ini (router-режим)
ORCHESTRATOR_ALIAS=orchestrator
# Контекст 32k, KV-кэш на GPU (проверено: 15.6 / 16.3 ГБ). Фоллбэки:
# LLAMA_ARG_KV_OFFLOAD=false (KV в RAM: VRAM −1.6 ГБ, генерация ~втрое медленнее)
# и/или ORCHESTRATOR_CTX=24576 → 16384.
ORCHESTRATOR_CTX=32768
LLAMA_ARG_KV_OFFLOAD=true
ORCHESTRATOR_NGL=99
ORCHESTRATOR_PARALLEL=1
KV_K=q4_0
KV_V=q4_0
FLASH_ATTN=on
ENABLE_THINKING=true
# Сон на простое: через N секунд без задач модель выгружается из RAM/VRAM,
# первый запрос перезагружает её (~1.5–2.5 мин). -1 = выключено.
SLEEP_IDLE_SECONDS=600

# ---- Порты (публикуются только на 127.0.0.1) ----
LLAMA_PORT=8080
OPENWEBUI_PORT=3000
SEARXNG_PORT=8888
LITELLM_PORT=4000
SEARCHMCP_PORT=8085
DELEGATE_PORT=8086
STUDY_PORT=8088
TOR_PORT=9050
EMBEDDINGS_PORT=8087

# ---- SearXNG ----
# Образы SearsXNG и alpine (init-рендер settings.yml), пин по digest
SEARXNG_IMAGE=docker.io/searxng/searxng@sha256:a07a5cd2da2c63d66e559f9e4d3a3db106cfc6c32fb0ac70abe91cc28bcd7350
ALPINE_IMAGE=alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
SEARXNG_SECRET=<сгенерировать>
# ---- Egress-прокси (разведены по сервисам) ----
# SearXNG-запросы через прокси (socks5h: DNS решает прокси; пусто = напрямую).
# Tor: socks5h://tor:9150; при блокировке Tor провайдером нужны мосты (см. README).
SEARXNG_PROXY=
# Прокси прямого пути web_url_read (пусто = напрямую)
URL_READER_PROXY=
# Прокси Byparr (пусто = с домашнего IP; socks5://tor:9150 = всё через Tor;
# http://user:pass@host:port = резидентный прокси)
BYPARR_PROXY=

# ---- Worker (OpenAI-совместимый роутер; ключ видит только LiteLLM) ----
# Префикс openai/ — обязателен для адаптера LiteLLM; далее — точный id модели роутера.
WORKER_MODEL=openai/<provider>/<model-id>
WORKER_BASE_URL=https://<роутер>/v1
WORKER_API_KEY=<ключ роутера>
# Локальная подмена воркера (переключение delegate на worker-local — без правок кода)
WORKER_LOCAL_MODEL=openai/orchestrator
WORKER_LOCAL_BASE_URL=http://llama-server:8080/v1
WORKER_LOCAL_API_KEY=none
LITELLM_MASTER_KEY=<сгенерировать>
# Образ LiteLLM (пин по digest)
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:a69f5f0c56b868d2fdfce7abfb037fed947b70ede202047ffc19c14dc96ab90a
# Образ mcp-searxng (поиск+чтение страниц для MCP), пин по digest
SEARCHMCP_IMAGE=isokoliuk/mcp-searxng@sha256:13939bb5076f2e93f7dbef41e6623592e4c70f3f8efac8951599ad1e80b4606e
# Образ Open WebUI (нужна версия >=0.6.31 для нативного MCP), пин по digest
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:8b432fe0a65b91116afc7961365c6cca5379cc923171386a96691f3471f3cae9

# ---- Ограничения контекста ----
WORKER_MAX_SOURCE_TOKENS=3000
WORKER_MAX_RESULT_TOKENS=800
SEARCH_RESULTS_COUNT=4
SEARXNG_MAX_RESULTS=4
URL_READ_MAX_CHARS=8000
DELEGATE_TASK_MAX_CHARS=1000

# ---- MCP / UI ----
SEARCH_MCP_TOKEN=<сгенерировать>
# Алиас воркера для delegate: worker (облако) или worker-local (локально)
DELEGATE_WORKER_MODEL=worker
# Сколько страниц из выдачи читать целиком (1-3)
DELEGATE_READ_TOP=2
# Санитайзер задачи: llm = локальный рерайт перед отправкой в облако; off = выключить.
# FAIL=reject — при сбое рерайта задача в облако НЕ уходит (безопасный режим).
DELEGATE_SANITIZE=llm
DELEGATE_SANITIZE_MAX_CHARS=300
DELEGATE_SANITIZE_FAIL=reject
# RAG (Open WebUI): сколько чанков подмешивать в контекст
RAG_TOP_K=4
# ---- Репетитор (study) ----
# База знаний Open WebUI, куда scripts\study_ingest.py загружает PDF по системному анализу
STUDY_KNOWLEDGE_NAME=Системный анализ
# Папка с PDF (используется только хост-скриптом scripts\study_ingest.py)
STUDY_DOCS_DIR=C:\path\to\study-pdfs
# Сколько «correct» подряд убирают карточку из ротации повторения
STUDY_RETIRE_STREAK=3
WEBUI_SECRET_KEY=<сгенерировать>
WEBUI_AUTH=true
# Headless-создание админа при первом старте (смените пароль в UI после входа)
WEBUI_ADMIN_EMAIL=admin@chumba.local
WEBUI_ADMIN_PASSWORD=<сгенерировать>
WEBUI_ADMIN_NAME=Admin

# ---- Linked notes / memory ----
# Internal token shared by OWUI memory proxy and notes service.
NOTES_INTERNAL_TOKEN=<generate>
# Separate bearer token for the notes MCP connection.
NOTES_AGENT_TOKEN=<generate>
# Experimental patched OWUI image built from pinned source + patch.
OPENWEBUI_MEMORY_IMAGE=chumba-open-webui-memory:local
OPENWEBUI_BASE_IMAGE=ghcr.io/open-webui/open-webui@sha256:8b432fe0a65b91116afc7961365c6cca5379cc923171386a96691f3471f3cae9
OPENWEBUI_REV=8bd8b4fac5e059578ac0c74b3c18d11139f88b7d
