+<script lang="ts">
+	import { onMount } from 'svelte';
+	import { goto } from '$app/navigation';
+	import { createNote, listNotes } from '$lib/apis/memory';
+
+	let notes: any[] = [];
+	let query = '';
+	let loading = true;
+	let error = '';
+	let seedOnly = true;
+	let typeFilter = 'all';
+
+	const load = async () => {
+		loading = true;
+		error = '';
+		try {
+			const data = await listNotes(query, 200);
+			notes = data.notes || [];
+		} catch (err: any) {
+			error = err?.data?.message || 'Cannot load memory';
+		} finally {
+			loading = false;
+		}
+	};
+
+	const create = async () => {
+		error = '';
+		try {
+			const key = crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
+			const note = await createNote({
+				title: 'New note',
+				type: 'reference',
+				status: 'active',
+				body: '',
+				sources: [],
+				idempotency_key: `ui-create-${key}`
+			});
+			goto(`/memory/${note.id}`);
+		} catch (err: any) {
+			error = err?.data?.message || 'Cannot create note';
+		}
+	};
+
+	$: projectNotes = seedOnly ? notes.filter((note) => note.id.startsWith('seed-')) : notes;
+	$: types = [...new Set(projectNotes.map((note) => note.type))].sort();
+	$: visibleNotes = projectNotes.filter((note) => typeFilter === 'all' || note.type === typeFilter);
+	$: overview = layout(visibleNotes);
+
+	const layout = (items: any[]) => {
+		const nodes = items;
+		const ids = new Set(nodes.map((note) => note.id));
+		const positions: Record<string, { x: number; y: number }> = {};
+		nodes.forEach((note, index) => {
+			const angle = (2 * Math.PI * index) / Math.max(1, nodes.length) - Math.PI / 2;
+			positions[note.id] = { x: 400 + 300 * Math.cos(angle), y: 220 + 170 * Math.sin(angle) };
+		});
+		const edges: any[] = [];
+		for (const note of nodes) {
+			for (const link of note.links || []) {
+				if (ids.has(link.id)) {
+					edges.push({ source: positions[note.id], target: positions[link.id] });
+				}
+			}
+		}
+		return {
+			nodes: nodes.map((note) => ({ ...note, ...(positions[note.id] || { x: 400, y: 220 }) })),
+			edges
+		};
+	};
+
+	onMount(load);
+</script>
+
+<div class="mx-auto flex h-full w-full max-w-7xl flex-col gap-4 p-4 md:p-8">
+	<header class="flex flex-wrap items-center justify-between gap-3">
+		<div>
+			<h1 class="text-2xl font-semibold">Memory</h1>
+			<p class="text-sm text-gray-500">Linked notes shared by you and the agent.</p>
+		</div>
+		<div class="flex flex-wrap gap-2">
+			<a class="rounded-lg border border-gray-300 px-3 py-2 text-sm dark:border-gray-700" href="/memory/seed-chumba-map">
+				Карта Chumba
+			</a>
+			<a class="rounded-lg border border-gray-300 px-3 py-2 text-sm dark:border-gray-700" href="/memory/graph">
+				Граф
+			</a>
+			<button class="rounded-lg bg-black px-3 py-2 text-sm text-white dark:bg-white dark:text-black" on:click={create}>
+				New note
+			</button>
+		</div>
+	</header>
+
+	<div class="flex flex-wrap items-center gap-3">
+		<input
+			class="min-w-[16rem] flex-1 rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm dark:border-gray-700"
+			placeholder="Search notes..."
+			bind:value={query}
+			on:input={load}
+		/>
+		<label class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
+			<input type="checkbox" bind:checked={seedOnly} />
+			только проектные seed
+		</label>
+		<select class="rounded-lg border border-gray-300 bg-transparent px-2 py-2 text-sm dark:border-gray-700" bind:value={typeFilter}>
+			<option value="all">все типы</option>
+			{#each types as item}
+				<option value={item}>{item}</option>
+			{/each}
+		</select>
+		<span class="text-xs text-gray-500">{visibleNotes.length} notes</span>
+	</div>
+
+	{#if error}
+		<div class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
+			{error}
+		</div>
+	{/if}
+
+	<section class="rounded-xl border border-gray-200 p-4 dark:border-gray-800">
+		<div class="flex flex-wrap items-center justify-between gap-3">
+			<div>
+				<h2 class="text-lg font-semibold">Карта графа</h2>
+				<p class="text-sm text-gray-500">Откройте интерактивный граф: масштаб, перетаскивание узлов, подсветка связей и переходы по узлам.</p>
+			</div>
+			<a class="rounded-lg bg-blue-600 px-4 py-2 text-sm text-white hover:bg-blue-700" href="/memory/graph">Открыть граф</a>
+		</div>
+	</section>
+
+	{#if loading}
+		<p class="text-sm text-gray-500">Loading...</p>
+	{:else if visibleNotes.length === 0}
+		<p class="text-sm text-gray-500">No notes yet.</p>
+	{:else}
+		<ul class="divide-y divide-gray-200 rounded-xl border border-gray-200 dark:divide-gray-800 dark:border-gray-800">
+			{#each visibleNotes as note (note.id)}
+				<li class="p-3">
+					<div class="flex flex-wrap items-center gap-2">
+						<a class="font-medium hover:underline" href={`/memory/${note.id}`}>{note.title}</a>
+						{#if note.id.startsWith('seed-')}
+							<span class="rounded bg-blue-100 px-1.5 text-xs text-blue-800 dark:bg-blue-900 dark:text-blue-100">seed</span>
+						{/if}
+						{#if note.updated_by?.includes('agent')}
+							<span class="rounded bg-amber-100 px-1.5 text-xs text-amber-800 dark:bg-amber-900 dark:text-amber-100">changed by agent</span>
+						{/if}
+					</div>
+					<div class="mt-1 flex flex-wrap gap-2 text-xs text-gray-500">
+						<span>{note.type}</span>
+						<span>{note.status}</span>
+						{#each note.links || [] as link}
+							<span>→ {link.title}</span>
+						{/each}
+					</div>
+				</li>
+			{/each}
+		</ul>
+	{/if}
+</div>
