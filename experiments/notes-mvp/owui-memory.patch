@@ -0,0 +1,54 @@
+import { WEBUI_API_BASE_URL } from '$lib/constants';
+
+const BASE = `${WEBUI_API_BASE_URL}/memory`;
+
+const request = async (path: string, options: RequestInit = {}) => {
+	const token = typeof localStorage !== 'undefined' ? localStorage.token : '';
+	const res = await fetch(`${BASE}${path}`, {
+		...options,
+		headers: {
+			Accept: 'application/json',
+			'Content-Type': 'application/json',
+			...(token ? { authorization: `Bearer ${token}` } : {}),
+			...(options.headers || {})
+		}
+	});
+	const data = await res.json().catch(() => ({}));
+	if (!res.ok) {
+		throw { status: res.status, data };
+	}
+	return data;
+};
+
+export const listNotes = (query = '', limit = 50) =>
+	request(`/notes?q=${encodeURIComponent(query)}&limit=${limit}`);
+
+export const getNote = (id: string) => request(`/notes/${encodeURIComponent(id)}`);
+
+export const createNote = (payload: any) =>
+	request('/notes', { method: 'POST', body: JSON.stringify(payload) });
+
+export const updateNote = (id: string, payload: any) =>
+	request(`/notes/${encodeURIComponent(id)}`, { method: 'PUT', body: JSON.stringify(payload) });
+
+export const getBacklinks = (id: string) =>
+	request(`/notes/${encodeURIComponent(id)}/backlinks`);
+
+export const getHistory = (id: string) =>
+	request(`/notes/${encodeURIComponent(id)}/history`);
+
+export const getDiff = (id: string, from?: string, to?: string) => {
+	const params = new URLSearchParams();
+	if (from) params.set('from', from);
+	if (to) params.set('to', to);
+	return request(`/notes/${encodeURIComponent(id)}/diff?${params.toString()}`);
+};
+
+export const restoreNote = (id: string, payload: any) =>
+	request(`/notes/${encodeURIComponent(id)}/restore`, {
+		method: 'POST',
+		body: JSON.stringify(payload)
+	});
+
+export const getGraph = (id: string) =>
+	request(`/notes/${encodeURIComponent(id)}/graph`);
