+<script lang="ts">
+	import { page } from '$app/stores';
+	import { getDiff, getGraph, getHistory, getNote, restoreNote, updateNote } from '$lib/apis/memory';
+	import DOMPurify from 'dompurify';
+	import { marked } from 'marked';
+
+	let id = '';
+	let loadedId = '';
+	let note: any = null;
+	let title = '';
+	let body = '';
+	let type = 'reference';
+	let status = 'active';
+	let revision = '';
+	let message = '';
+	let error = '';
+	let history: any[] = [];
+	let diff = '';
+	let selectedRevision = '';
+	let graph: any = { nodes: [], edges: [] };
+	let showPreview = true;
+
+	const linkPattern = /\[\[([A-Za-z0-9_-]{1,64})(?:\|([^\]]+))?\]\]/g;
+
+	const previewBody = (value: string) =>
+		value.replace(linkPattern, (_match, target, label) => `[${label || target}](/memory/${target})`);
+
+	$: preview = DOMPurify.sanitize(marked.parse(previewBody(body)) as string);
+
+	const layout = (value: any) => {
+		const nodes = value?.nodes || [];
+		const positions: Record<string, { x: number; y: number }> = {};
+		nodes.forEach((node: any, index: number) => {
+			const angle = (2 * Math.PI * index) / Math.max(1, nodes.length) - Math.PI / 2;
+			positions[node.id] = { x: 220 + 145 * Math.cos(angle), y: 160 + 115 * Math.sin(angle) };
+		});
+		return {
+			nodes: nodes.map((node: any) => ({ ...node, ...(positions[node.id] || { x: 220, y: 160 }) })),
+			edges: (value?.edges || []).map((edge: any) => ({
+				...edge,
+				sourcePos: positions[edge.source],
+				targetPos: positions[edge.target]
+			}))
+		};
+	};
+
+	$: graphView = layout(graph);
+
+	const load = async (noteId: string) => {
+		error = '';
+		message = '';
+		try {
+			const data = await getNote(noteId);
+			note = data;
+			title = data.title;
+			body = data.body || '';
+			type = data.type || 'reference';
+			status = data.status || 'active';
+			revision = data.revision;
+			loadedId = noteId;
+			const [historyData, graphData] = await Promise.all([getHistory(noteId), getGraph(noteId)]);
+			history = historyData.history || [];
+			graph = graphData || { nodes: [], edges: [] };
+		} catch (err: any) {
+			error = err?.data?.message || 'Cannot load note';
+		}
+	};
+
+	$: if ($page.params.id && $page.params.id !== loadedId) {
+		id = $page.params.id;
+		load(id);
+	}
+
+	const save = async () => {
+		error = '';
+		message = '';
+		try {
+			const key = crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
+			const data = await updateNote(id, {
+				title,
+				body,
+				type,
+				status,
+				expected_revision: revision,
+				idempotency_key: `ui-edit-${key}`
+			});
+			note = data;
+			revision = data.revision;
+			message = 'Saved';
+			const [historyData, graphData] = await Promise.all([getHistory(id), getGraph(id)]);
+			history = historyData.history || [];
+			graph = graphData || { nodes: [], edges: [] };
+		} catch (err: any) {
+			if (err?.status === 409) {
+				error = `${err.data?.message || 'Revision conflict'}. Current revision: ${err.data?.current_revision || 'unknown'}. Reloading.`;
+				await load(id);
+			} else {
+				error = err?.data?.message || 'Cannot save note';
+			}
+		}
+	};
+
+	const showDiff = async (value: string) => {
+		selectedRevision = value;
+		try {
+			const data = await getDiff(id, value, revision);
+			diff = data.diff || 'No changes in body.';
+		} catch (err: any) {
+			error = err?.data?.message || 'Cannot load diff';
+		}
+	};
+
+	const restore = async (value: string) => {
+		error = '';
+		message = '';
+		try {
+			const key = crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
+			await restoreNote(id, {
+				revision: value,
+				expected_revision: revision,
+				idempotency_key: `ui-restore-${key}`
+			});
+			message = 'Revision restored as a new revision';
+			await load(id);
+		} catch (err: any) {
+			error = err?.data?.message || 'Cannot restore revision';
+		}
+	};
+</script>
+
+<div class="mx-auto flex h-full w-full max-w-6xl flex-col gap-4 p-4 md:p-8">
+	<div class="flex flex-wrap items-center justify-between gap-3">
+		<div class="flex items-center gap-3">
+			<a class="text-sm text-blue-600 hover:underline dark:text-blue-400" href="/memory">← Memory</a>
+			<a class="text-sm text-blue-600 hover:underline dark:text-blue-400" href={`/memory/graph?mode=local&center=${id}&depth=1`}>Граф</a>
+		</div>
+		<div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
+			{#if note?.id?.startsWith('seed-')}
+				<span class="rounded bg-blue-100 px-1.5 py-0.5 text-blue-800 dark:bg-blue-900 dark:text-blue-100">seed documentation</span>
+			{/if}
+			<span>{note?.updated_by?.includes('agent') ? 'Last change by agent' : 'Last change by user'}</span>
+			{#if note?.updated_at} · {note.updated_at}{/if}
+		</div>
+	</div>
+
+	{#if error}
+		<div class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
+			{error}
+		</div>
+	{/if}
+	{#if message}
+		<div class="rounded-lg border border-green-300 bg-green-50 p-3 text-sm text-green-700 dark:border-green-900 dark:bg-green-950 dark:text-green-200">
+			{message}
+		</div>
+	{/if}
+
+	{#if note}
+		<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_18rem]">
