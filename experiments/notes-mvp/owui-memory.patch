+			node.vx += (W / 2 - node.x) * centerPull;
+			node.vy += (H / 2 - node.y) * centerPull;
+			node.vx *= 0.86;
+			node.vy *= 0.86;
+			if (node.id !== dragging) {
+				node.x = Math.max(PAD, Math.min(W - PAD, node.x + node.vx));
+				node.y = Math.max(PAD, Math.min(H - PAD, node.y + node.vy));
+				positions[node.id] = { x: node.x, y: node.y };
+				maxSpeed = Math.max(maxSpeed, Math.hypot(node.vx, node.vy));
+			}
+		}
+		return maxSpeed;
+	};
