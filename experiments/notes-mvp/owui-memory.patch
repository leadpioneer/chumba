+			const d = Math.max(1, Math.hypot(dx, dy));
+			const force = (d - linkDistance) * 0.002;
+			const fx = (dx / d) * force;
+			const fy = (dy / d) * force;
+			a.vx += fx;
+			a.vy += fy;
+			b.vx -= fx;
+			b.vy -= fy;
+		}
